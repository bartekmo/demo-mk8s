#!/bin/bash
apt update
apt upgrade -y
apt install git -y

snap install microk8s --classic --channel=1.35
microk8s status --wait-ready

mkdir -p /etc/skel/.kube
chmod 0700 /etc/skel/.kube

# Admin (OS Login) user: not in /etc/passwd, so usermod won't work, but
# initgroups() still honours /etc/group membership for NSS-provided users.
admin_user='${admin_username}'
if ! grep -qE "^microk8s:.*[:,]$${admin_user}(,|$)" /etc/group; then
  sed -i -E "/^microk8s:/{s/$/,$${admin_user}/; s/:,/:/}" /etc/group
fi

# metadata-key users: guest agent adds them to these groups on creation
if [ ! -e /etc/default/instance_configs.cfg ]; then
  distro_groups=$(sed -n 's/^groups *= *//p' /etc/default/instance_configs.cfg.distro | head -n1)
  distro_groups=$${distro_groups:-adm,dip,docker,lxd,plugdev,video}
  cat > /etc/default/instance_configs.cfg <<EOF
[Accounts]
groups = $${distro_groups},microk8s
EOF
fi

systemctl restart google-guest-agent 2>/dev/null || true

%{ if is_primary ~}
# ===== Primary (node-0): control plane + cluster-wide addons =====

# Register the pre-shared join token (generated by Terraform) so worker
# nodes can join without any operator action. A token with a TTL is
# reusable until it expires; re-running this on reboot is harmless.
microk8s add-node --token '${join_token}' --token-ttl ${join_token_ttl} >/dev/null

kubectl() { microk8s kubectl "$@"; }

# Block pods from the GCE metadata server before any workload starts: the
# node service account holds the PD CSI disk permissions.
kubectl wait --for condition=established --timeout=5m \
  crd/adminnetworkpolicies.policy.networking.k8s.io
kubectl apply -f - <<'YAML'
${metadata_concealment}
YAML

microk8s enable metallb:${mlb_range}
microk8s enable ingress

# Pin the ingress (Traefik) LoadBalancer Service to a fixed mlb address
# instead of MetalLB's first free one. The LB's NEG endpoint points here.
traefik_ip='${traefik_ip}'
svc=""
for i in $(seq 60); do
  svc=$(microk8s kubectl get svc -A --field-selector spec.type=LoadBalancer \
    -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' \
    | grep -i -m1 -e ingress -e traefik)
  [ -n "$svc" ] && break
  sleep 5
done
if [ -n "$svc" ]; then
  microk8s kubectl -n "$${svc%%/*}" annotate svc "$${svc#*/}" --overwrite \
    metallb.io/loadBalancerIPs="$traefik_ip" \
    metallb.universe.tf/loadBalancerIPs="$traefik_ip"
else
  echo "ingress LoadBalancer service not found; Traefik IP not pinned" >&2
fi

# --- cert-manager + Let's Encrypt issuer ---
microk8s enable cert-manager
kubectl -n cert-manager rollout status deploy/cert-manager-webhook --timeout=5m
# the webhook can still refuse requests for a few seconds after rollout
for i in $(seq 30); do
  kubectl apply -f - <<'YAML' && break
${cluster_issuer}
YAML
  sleep 10
done

# --- Argo CD ---
kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
kubectl apply -n argocd --server-side --force-conflicts \
  -f https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/install.yaml
kubectl wait --for condition=established crd/applications.argoproj.io --timeout=2m

# --- In-cluster generated secrets (never in Git / Terraform state) ---
# authentik: app + DB secrets, akadmin and "demo" passwords, Argo CD OIDC
# client secret (shared with argocd/argocd-oidc). Created once, kept on reboot.
gen() { openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-32; }
kubectl create namespace authentik --dry-run=client -o yaml | kubectl apply -f -
if ! kubectl -n authentik get secret authentik-bootstrap >/dev/null 2>&1; then
  kubectl -n authentik create secret generic authentik-bootstrap \
    --from-literal=secret-key="$(openssl rand -base64 60 | tr -d '\n')" \
    --from-literal=postgres-password="$(gen)" \
    --from-literal=postgres-admin-password="$(gen)" \
    --from-literal=akadmin-password="$(gen)" \
    --from-literal=demo-password="$(gen)" \
    --from-literal=argocd-client-secret="$(gen)"
fi
if ! kubectl -n argocd get secret argocd-oidc >/dev/null 2>&1; then
  oidc_secret=$(kubectl -n authentik get secret authentik-bootstrap \
    -o jsonpath='{.data.argocd-client-secret}' | base64 -d)
  kubectl -n argocd create secret generic argocd-oidc \
    --from-literal=clientSecret="$oidc_secret"
  # Argo CD only resolves $secret:key references from its own labelled secrets
  kubectl -n argocd label secret argocd-oidc app.kubernetes.io/part-of=argocd
fi

# Traefik terminates TLS, so argocd-server serves plain HTTP
kubectl -n argocd patch cm argocd-cmd-params-cm --type merge \
  -p '{"data":{"server.insecure":"true"}}'
# SSO via authentik + RBAC (group argocd-admins -> role:admin)
kubectl -n argocd patch cm argocd-cm --type merge --patch-file /dev/stdin <<'YAML'
${argocd_cm_patch}
YAML
kubectl -n argocd patch cm argocd-rbac-cm --type merge --patch-file /dev/stdin <<'YAML'
${argocd_rbac_cm_patch}
YAML
kubectl -n argocd rollout restart deploy/argocd-server
kubectl -n argocd rollout status deploy/argocd-server --timeout=5m

kubectl apply -f - <<'YAML'
${argocd_ingress}
YAML

# GitOps: one Argo CD app per directory under the repo path
kubectl wait --for condition=established crd/applicationsets.argoproj.io --timeout=2m
kubectl apply -f - <<'YAML'
${argocd_appset}
YAML

# Self-check: pods must NOT reach the metadata server (logged to serial console)
check=$(kubectl run metadata-check --rm -i --restart=Never --image=curlimages/curl \
  --pod-running-timeout=3m --command -- sh -c \
  "curl -sf -m 5 -H 'Metadata-Flavor: Google' http://169.254.169.254/computeMetadata/v1/instance/id >/dev/null && echo REACHABLE || echo BLOCKED" 2>&1)
case "$check" in
  *REACHABLE*) echo "WARNING: pods can reach the GCE metadata server - concealment NOT working" >&2 ;;
  *BLOCKED*)   echo "metadata concealment OK: pods cannot reach the GCE metadata server" ;;
  *)           echo "metadata concealment check inconclusive: $check" >&2 ;;
esac
%{ else ~}
# ===== Worker: join node-0 =====
# node-0 may still be bootstrapping, so retry for up to ~60 minutes.
# The marker keeps reboots (startup script re-runs) from re-joining.
joined_marker=/var/snap/microk8s/common/.joined
if [ ! -e "$joined_marker" ]; then
  for i in $(seq 120); do
    if microk8s join '${primary_ip}:25000/${join_token}' --worker; then
      touch "$joined_marker"
      break
    fi
    echo "join attempt $i failed; retrying in 30s" >&2
    sleep 30
  done
  [ -e "$joined_marker" ] || echo "failed to join ${primary_ip}" >&2
fi
%{ endif ~}