# IDE (code-server): chart from the platform repo, plus an optional values
# file from the GitLab project demo-apps/codeshell. That project's CI updates
# deploy/code-server-values.yaml (image tag) after each build, so the IDE
# follows the codeshell image without changes to the platform repo.
# Until GitLab and the project exist, this app shows a comparison error and
# nothing is deployed; it syncs as soon as the repo is reachable.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: code-server
  namespace: argocd
spec:
  project: default
  sources:
    - repoURL: ${repo_url}
      targetRevision: ${repo_revision}
      path: ${repo_path}/code-server
      helm:
        releaseName: code-server
        valuesObject:
          global:
            dnsRoot: ${dns_root}
        valueFiles:
          - $overrides/deploy/code-server-values.yaml
        ignoreMissingValueFiles: true
    # public project, read via GitLab's in-cluster address (no DNS/TLS needed)
    - repoURL: ${overrides_repo_url}
      targetRevision: main
      ref: overrides
  destination:
    server: https://kubernetes.default.svc
    namespace: code-server
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 30
      backoff:
        duration: 30s
        factor: 2
        maxDuration: 5m
