# ${name}: chart from the platform repo, plus an optional values file from a
# GitLab project (${overrides_repo_url}). That project's CI writes
# ${values_file} (image tag) after each build, so the app follows its own
# builds without changes to the platform repo.
# Until GitLab and the project exist, this app shows a comparison error and
# nothing is deployed; it syncs as soon as the repo is reachable.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${name}
  namespace: argocd
spec:
  project: default
  sources:
    - repoURL: ${repo_url}
      targetRevision: ${repo_revision}
      path: ${repo_path}/${name}
      helm:
        releaseName: ${name}
        valuesObject:
          global:
            dnsRoot: ${dns_root}
        valueFiles:
          - $overrides/${values_file}
        ignoreMissingValueFiles: true
    # public project, read via GitLab's in-cluster address (no DNS/TLS needed)
    - repoURL: ${overrides_repo_url}
      targetRevision: ${overrides_revision}
      ref: overrides
  destination:
    server: https://kubernetes.default.svc
    namespace: ${name}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 30
      backoff:
        duration: 30s
        factor: 2
        maxDuration: 5m
